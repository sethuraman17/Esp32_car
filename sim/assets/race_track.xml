<mujoco model="esp32_race_track">
  <compiler angle="degree" coordinate="local" inertiafromgeom="false"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.65 0.65 0.65" specular="0.2 0.2 0.2"/>
    <rgba haze="0.55 0.65 0.75 1"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <statistic center="0 0 0.3" extent="6"/>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.35 0.55 0.85" rgb2="0.05 0.08 0.15" width="512" height="512"/>
    <texture name="grass" type="2d" builtin="checker" rgb1="0.18 0.32 0.14" rgb2="0.22 0.38 0.18" width="512" height="512"/>
    <texture name="asphalt" type="2d" builtin="checker" rgb1="0.28 0.28 0.30" rgb2="0.18 0.18 0.20" width="300" height="300"/>
    <texture name="kerb" type="2d" builtin="checker" rgb1="0.95 0.95 0.95" rgb2="0.85 0.12 0.12" width="128" height="128"/>
    <material name="grass_mat" texture="grass" texrepeat="12 12" reflectance="0.05"/>
    <material name="asphalt_mat" texture="asphalt" texrepeat="10 6" reflectance="0.08"/>
    <material name="kerb_mat" texture="kerb" texrepeat="6 1" reflectance="0.1"/>
    <material name="wall_mat" rgba="0.75 0.75 0.78 1"/>
    <material name="start_mat" rgba="0.1 0.85 0.25 1"/>
    <material name="finish_mat" rgba="0.95 0.85 0.1 1"/>
    <material name="cone_mat" rgba="1 0.45 0.05 1"/>
    <material name="arch_mat" rgba="0.9 0.1 0.15 1"/>
  </asset>

  <include file="esp32_car.xml"/>

  <worldbody>
    <light pos="0 0 10" dir="0 0 -1" diffuse="0.85 0.88 0.92" castshadow="true"/>
    <light pos="-4 -3 5" dir="1 1 -1" diffuse="0.25 0.28 0.32" castshadow="false"/>

    <!-- Infield -->
    <!-- Drive surface. Tires push on this plane. -->
    <geom name="infield" type="plane" size="12 12 0.1" material="grass_mat"
          contype="1" conaffinity="1" friction="1.3 0.02 0.001"/>

    <!-- Visual lane only, so it does not block the tires -->
    <geom name="track_surface" type="box" size="4.2 2.6 0.004" pos="0 0 -0.002" material="asphalt_mat" contype="0" conaffinity="0"/>
    <geom name="track_inner_grass" type="box" size="2.4 1.2 0.004" pos="0 0 0.001" material="grass_mat" contype="0" conaffinity="0"/>

    <!-- Kerbs -->
    <geom name="kerb_top" type="box" size="4.25 0.12 0.025" pos="0 2.55 0.018" material="kerb_mat" contype="1" conaffinity="1"/>
    <geom name="kerb_bottom" type="box" size="4.25 0.12 0.025" pos="0 -2.55 0.018" material="kerb_mat" contype="1" conaffinity="1"/>
    <geom name="kerb_left" type="box" size="0.12 2.55 0.025" pos="-4.25 0 0.018" material="kerb_mat" contype="1" conaffinity="1"/>
    <geom name="kerb_right" type="box" size="0.12 2.55 0.025" pos="4.25 0 0.018" material="kerb_mat" contype="1" conaffinity="1"/>

    <!-- Outer retaining walls -->
    <geom name="wall_n" type="box" size="4.35 0.08 0.18" pos="0 2.75 0.18" material="wall_mat" contype="1" conaffinity="1"/>
    <geom name="wall_s" type="box" size="4.35 0.08 0.18" pos="0 -2.75 0.18" material="wall_mat" contype="1" conaffinity="1"/>
    <geom name="wall_w" type="box" size="0.08 2.75 0.18" pos="-4.35 0 0.18" material="wall_mat" contype="1" conaffinity="1"/>
    <geom name="wall_e" type="box" size="0.08 2.75 0.18" pos="4.35 0 0.18" material="wall_mat" contype="1" conaffinity="1"/>

    <!-- Start / finish strip -->
    <geom name="start_line" type="box" size="0.35 1.05 0.003" pos="3.6 0 0.022" material="start_mat"/>
    <geom name="finish_line" type="box" size="0.08 1.05 0.004" pos="3.15 0 0.023" material="finish_mat"/>

    <!-- Start arch -->
    <geom name="arch_l" type="box" size="0.06 0.06 0.55" pos="3.55 0.95 0.55" material="arch_mat" contype="1" conaffinity="1"/>
    <geom name="arch_r" type="box" size="0.06 0.06 0.55" pos="3.55 -0.95 0.55" material="arch_mat" contype="1" conaffinity="1"/>
    <geom name="arch_top" type="box" size="0.08 1.05 0.06" pos="3.55 0 1.08" material="arch_mat" contype="1" conaffinity="1"/>

    <!-- Fun cones along one straight -->
    <geom name="cone1" type="cylinder" size="0.06 0.08" pos="-2.5 2.15 0.08" material="cone_mat" contype="1" conaffinity="1"/>
    <geom name="cone2" type="cylinder" size="0.06 0.08" pos="-0.8 2.15 0.08" material="cone_mat" contype="1" conaffinity="1"/>
    <geom name="cone3" type="cylinder" size="0.06 0.08" pos="0.9 2.15 0.08" material="cone_mat" contype="1" conaffinity="1"/>
    <geom name="cone4" type="cylinder" size="0.06 0.08" pos="2.2 2.15 0.08" material="cone_mat" contype="1" conaffinity="1"/>

    <!-- Broadcast camera -->
    <camera name="track_cam" pos="0 -6.5 3.5" xyaxes="1 0 0 0 0.45 0.89"/>
  </worldbody>
</mujoco>
